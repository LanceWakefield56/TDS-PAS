# BrightPAS source style. `dotnet format whitespace BrightPAS.slnx --verify-no-changes` must pass before a release.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,json,css,html,yml,yaml,csproj,props,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sql]
end_of_line = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[*.cs]
# House style: compact code – short related statements and guard clauses may share a line.
csharp_preserve_single_line_statements = true
csharp_preserve_single_line_blocks = true
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

# Generated by EF Core – never formatted or edited by hand.
[**/Migrations/*.cs]
generated_code = true

# ---------------------------------------------------------------------------------------------------------------
[*.cs]
# Code analysis (Directory.Build.props turns on recommended + all security/reliability rules; findings fail the build).
# Rules switched off on purpose:
# CA1707 underscores in names: test names are sentences (Monitor_feed_connect_capture_validate_and_reject).
dotnet_diagnostic.CA1707.severity = none
# CA1305 IFormatProvider: every process pins its culture to en-NZ at start-up (Program.cs, Setup, TestBot) and
#   machine formats (HL7, CSV, JSON, SQL) use InvariantCulture explicitly, so the server's regional settings cannot leak in.
dotnet_diagnostic.CA1305.severity = none
# CA1725 parameter names matching the base: EF/ASP.NET overrides keep descriptive names.
dotnet_diagnostic.CA1725.severity = none
# CA1848/CA1873 LoggerMessage delegates: logging is low-volume; plain structured logging is clearer.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# CA1861 constant arrays as arguments: used in EF migrations (generated) and one-off start-up code.
dotnet_diagnostic.CA1861.severity = none
# CA1716/CA1720/CA1711/CA1710 naming against VB keywords / type names: public API is not consumed from other languages.
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1710.severity = none
# CA1822/CA1859 'could be static' / 'use concrete type': style suggestions, kept as information only.
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1859.severity = suggestion
# CA1068 CancellationToken last / CA1000 static members on generic types / CA1051 visible fields: API shape kept for readability.
dotnet_diagnostic.CA1068.severity = none
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1051.severity = none
# CA1852 seal internal types: suggestion.
dotnet_diagnostic.CA1852.severity = suggestion
# CA1865 char overloads: suggestion.
dotnet_diagnostic.CA1865.severity = suggestion

[tests/**.cs]
# Tests compute TOTP codes (RFC 6238 requires HMAC-SHA1) and derive stable test ids with MD5 – not used for security.
dotnet_diagnostic.CA5350.severity = none
dotnet_diagnostic.CA5351.severity = none
