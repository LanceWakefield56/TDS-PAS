<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Setup</AssemblyName>
    <RootNamespace>BrightPAS.Setup</RootNamespace>
    <!-- Published as one self-contained Setup.exe for Windows Server (no .NET install needed to run it). -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Partial trimming: only framework assemblies that opt in are trimmed; SqlClient and its dependencies are kept
         whole. SqlClient's own trim warnings (IL2104) are suppressed; the database steps are verified by integration tests
         against SQL Server using a trimmed build. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\BrightPAS.Shared\BrightPAS.Shared.csproj" />
    <ProjectReference Include="..\..\Platform\BrightPAS.Licensing\BrightPAS.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\*.sql" LogicalName="Database.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
