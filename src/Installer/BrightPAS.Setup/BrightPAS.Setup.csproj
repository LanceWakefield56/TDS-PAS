<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Setup</AssemblyName>
    <RootNamespace>BrightPAS.Setup</RootNamespace>
    <!-- Published as one self-contained Setup.exe for Windows Server (no .NET install needed to run it). -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- NOT trimmed (0.5.1). Trimming broke Microsoft.Data.SqlClient's Windows native SNI interop
         (TypeLoadException in SNIAddProviderWrapper when opening an encrypted connection). Linux CI uses the
         managed SNI so it never caught this. A larger Setup.exe is acceptable; correctness is not negotiable. -->
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\BrightPAS.Shared\BrightPAS.Shared.csproj" />
    <ProjectReference Include="..\..\Platform\BrightPAS.Licensing\BrightPAS.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\*.sql" LogicalName="Database.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
