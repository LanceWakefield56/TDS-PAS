<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for the PAS site. The publish step fills in processPath/arguments. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Tds.Pas.Web.dll" stdoutLogEnabled="false" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true" allowDoubleEscaping="false">
          <requestLimits maxAllowedContentLength="52428800" />
          <hiddenSegments>
            <add segment="appsettings.json" />
            <add segment="appsettings.Production.json" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
